{
  "name": "@distil/cli",
  "version": "0.3.1",
  "private": true,
  "type": "module",
  "exports": "./src/main.ts",
  "scripts": {
    "distil": "bun --no-env-file src/main.ts",
    "quality": "bun fmt --check && bun lint",
    "verify": "bun --check && bun test --check",
    "check": "bun run quality && bun run verify",
    "test": "bun test --check",
    "compile": "bun build --compile --minify --no-compile-autoload-dotenv --no-compile-autoload-bunfig --outfile distil-bin src/main.ts"
  },
  "engines": {
    "bun": ">=1.4.3"
  }
}
